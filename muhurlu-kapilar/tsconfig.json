{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["source/*"]
    }
  },
  "include": ["source/**/*.ts", "source/**/*.tsx", "example/**/*.tsx", "demo/**/*.ts", "demo/**/*.tsx"]
}
